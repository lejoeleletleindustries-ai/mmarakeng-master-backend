NODE_ENV=production
PORT=10000
HOST=0.0.0.0
DATABASE_URL=
JWT_SECRET=
SESSION_SECRET=
CURRENCY=LSL

# Owners (seed only — never commit real passwords)
OWNER1_NAME=Lejwele Le Te Industries
OWNER1_EMAIL=
OWNER1_PHONE=
OWNER1_PASSWORD=
OWNER2_NAME=Origin Dot
OWNER2_EMAIL=
OWNER2_PHONE=
OWNER2_PASSWORD=
ADMIN_PHONE=
ADMIN_PASSWORD=

# OTP
OTP_REQUIRED=0
OTP_SECRET=
OTP_SANDBOX=0

# CAPTCHA (optional production provider)
HCAPTCHA_SECRET=
HCAPTCHA_SITEKEY=
CAPTCHA_REQUIRED=0

# Object storage (production)
STORAGE_PROVIDER=local
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Payments global
PAYMENTS_MODE=production
PLATFORM_FEE_PERCENT=0

# M-Pesa Lesotho (all empty until official credentials)
MPESA_ENABLED=false
MPESA_ENVIRONMENT=sandbox
MPESA_API_BASE_URL=
MPESA_API_VERSION=
MPESA_CLIENT_ID=
MPESA_CLIENT_SECRET=
MPESA_MERCHANT_ID=
MPESA_BUSINESS_ID=
MPESA_SHORTCODE=
MPESA_CALLBACK_URL=
MPESA_TIMEOUT_MS=30000
MPESA_WEBHOOK_SECRET=

# EcoCash Lesotho (all empty until official credentials)
ECOCASH_ENABLED=false
ECOCASH_ENVIRONMENT=sandbox
ECOCASH_API_BASE_URL=
ECOCASH_API_VERSION=
ECOCASH_CLIENT_ID=
ECOCASH_CLIENT_SECRET=
ECOCASH_MERCHANT_ID=
ECOCASH_BUSINESS_ID=
ECOCASH_CALLBACK_URL=
ECOCASH_TIMEOUT_MS=30000
ECOCASH_WEBHOOK_SECRET=

CORS_ORIGIN=*
DATABASE_SSL=

# Security
JWT_EXPIRES_IN=7d
# CORS_ORIGIN=https://your-app.example.com

# Google Maps (never commit real keys)
# Browser/client key for maps UI only:
GOOGLE_MAPS_BROWSER_KEY=
# Server-side key if needed for future geocoding (keep secret):
GOOGLE_MAPS_API_KEY=

# Distress notification providers (optional)
SMS_PROVIDER=
SMS_API_KEY=
EMAIL_PROVIDER=
EMAIL_API_KEY=
